{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lithium Config",
  "scopeName": "source.lithium.config",
  "fileTypes": ["litc"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#config-block" },
    { "include": "#keys" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.lithium", "match": "#.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lithium",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.lithium", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.lithium", "match": "\\b\\d+(\\.\\d+)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.lithium",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "config-block": {
      "patterns": [
        {
          "name": "entity.name.type.lithium",
          "match": "\\bconfig\\b(?=\\s*\\()"
        }
      ]
    },
    "keys": {
      "patterns": [
        {
          "name": "entity.name.tag.lithium",
          "match": "\\b([A-Za-z_][A-Za-z0-9_-]*)\\b(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.lithium", "match": "=|[\\{\\}\\[\\]\\(\\);,]" }
      ]
    }
  }
}